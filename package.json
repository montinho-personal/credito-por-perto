{
  "name": "credito-por-perto",
  "version": "0.1.0",
  "private": true,
  "description": "Portal editorial independente sobre empréstimos, crédito, juros e segurança financeira.",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/generate-search-index.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:originality": "tsx scripts/audit-originality.ts",
    "audit:canonical": "tsx scripts/audit-canonical.ts",
    "audit:cannibalization": "tsx scripts/audit-cannibalization.ts",
    "audit:local": "tsx scripts/audit-local-pages.ts",
    "audit:mapa": "tsx scripts/audit-financial-map.ts",
    "audit:ferramentas": "tsx scripts/audit-tool-coverage.ts",
    "audit:links": "tsx scripts/audit-internal-links.ts",
    "audit:metadata": "tsx scripts/audit-metadata.ts",
    "audit:sources": "tsx scripts/audit-sources.ts",
    "audit:readability": "tsx scripts/audit-readability.ts",
    "audit:all": "pnpm audit:originality && pnpm audit:canonical && pnpm audit:cannibalization && pnpm audit:local && pnpm audit:mapa && pnpm audit:ferramentas && pnpm audit:links && pnpm audit:metadata && pnpm audit:sources && pnpm audit:readability",
    "search:index": "tsx scripts/generate-search-index.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "next": "16.3.0",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
