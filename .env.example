# =============================================================
# Crédito Por Perto — variáveis de ambiente
# Copie para .env.local e preencha com valores REAIS.
# Nunca comite valores reais; nunca invente IDs.
# =============================================================

# --- Google AdSense ---
# O Publisher ID real está em src/lib/adsense/config.ts. Estas variáveis são
# apenas sobrescritas opcionais — em produção não é preciso definir nenhuma.
#
# ATENÇÃO: "false" aqui é o INTERRUPTOR DE EMERGÊNCIA. Ele desliga o AdSense
# inteiro, inclusive o script que conecta o site à conta. Se esta variável
# estiver definida como "false" no Vercel, o Google não encontra o código e a
# revisão falha. Deixe-a ausente em produção.
# NEXT_PUBLIC_ADSENSE_ENABLED=false
#
# Sobrescreve o Publisher ID do código (raramente necessário).
# NEXT_PUBLIC_ADSENSE_CLIENT=
#
# IDs de blocos de anúncio. Enquanto vazios, NENHUMA unidade renderiza —
# só o script da conta é carregado. Preencha um de cada vez, depois da
# aprovação, medindo o efeito em leitura e Core Web Vitals.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY=

# --- Google Analytics 4 (opcional; carregado só com consentimento) ---
# Preencha com o ID real (formato G-XXXXXXXXXX) para ativar o banner de
# consentimento; o GA4 só carrega depois do "Aceitar" do visitante.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Google Tag Manager (opcional) ---
NEXT_PUBLIC_GTM_ID=

# --- Google Search Console ---
# Código do meta tag de verificação (somente o token)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Vercel (definidas automaticamente pela plataforma) ---
# VERCEL_ENV=production | preview | development

# --- Banco Central (somente teste/desenvolvimento; ignoradas em produção) ---
# Sobrescreve a base do SGS (Minha taxa está cara?) para apontar a um mock local
# BCB_SGS_BASE_URL=
# Sobrescreve a base Olinda de instituições (consulta de instituição) para mock local
# BCB_INSTITUTIONS_BASE_URL=
