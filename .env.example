# =============================================================
# Crédito Por Perto — variáveis de ambiente
# Copie para .env.local e preencha com valores REAIS.
# Nunca comite valores reais; nunca invente IDs.
# =============================================================

# --- Google AdSense (desativado por padrão) ---
# Só mude para "true" quando houver conta aprovada e IDs reais.
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Ex.: ca-pub-0000000000000000 (fornecido pelo AdSense)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY=

# --- Google Analytics 4 (opcional; carregado só com consentimento) ---
# Preencha com o ID real (formato G-XXXXXXXXXX) para ativar o banner de
# consentimento; o GA4 só carrega depois do "Aceitar" do visitante.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Google Tag Manager (opcional) ---
NEXT_PUBLIC_GTM_ID=

# --- Google Search Console ---
# Código do meta tag de verificação (somente o token)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Vercel (definidas automaticamente pela plataforma) ---
# VERCEL_ENV=production | preview | development
